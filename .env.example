# Postgres connection string (Neon / Supabase / local)
DATABASE_URL=postgres://user:password@host:5432/skysound
# Absolute site URL for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://example.com
# Contact URL or email sent in the User-Agent to catalog APIs (Wikimedia/CDS policy)
CATALOG_CONTACT=https://example.com/contact
