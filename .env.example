# ── Local development (npm run dev) — copy to .env.local ──────────────────────
# Postgres connection string (local / Neon / Supabase)
DATABASE_URL=postgres://user:password@localhost:5432/skysound
# Absolute public URL: canonical links, sitemap, robots, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact URL or email sent in the User-Agent to catalog APIs (Wikimedia / CDS policy)
CATALOG_CONTACT=https://example.com/contact

# ── docker compose — copy to .env ─────────────────────────────────────────────
# Public URL of the deployment (becomes NEXT_PUBLIC_SITE_URL inside the container)
SITE_URL=https://cosmos.example.com
POSTGRES_USER=skysound
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skysound
# Host port the app is published on (put a reverse proxy with TLS in front of it)
APP_PORT=3000
